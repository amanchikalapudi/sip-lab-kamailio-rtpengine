#!KAMAILIO
#
# Kamailio SIP Proxy / Registrar — starter template
# Replace REPLACE_ME_* placeholders with your own environment values.

debug=2
log_stderror=no
fork=yes
children=4

listen=udp:REPLACE_ME_LAN_IP:5060
alias="REPLACE_ME_DOMAIN"

# --- modules -----------------------------------------------------------
loadmodule "tm.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"
loadmodule "textops.so"
loadmodule "maxfwd.so"
loadmodule "rtpengine.so"

modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:22222")
modparam("usrloc", "db_mode", 0)

# --- routing logic -------------------------------------------------------
request_route {
    if (!mf_process_maxfwd_header("10")) {
        sl_send_reply("483", "Too Many Hops");
        exit;
    }

    if (is_method("REGISTER")) {
        save("location");
        exit;
    }

    if (is_method("INVITE")) {
        rtpengine_offer();
    }

    if (!lookup("location")) {
        sl_send_reply("404", "Not Found");
        exit;
    }

    route(RELAY);
}

route[RELAY] {
    if (is_method("BYE|CANCEL")) {
        rtpengine_delete();
    }
    if (!t_relay()) {
        sl_reply_error();
    }
    exit;
}
